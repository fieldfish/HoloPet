{
  "provider": "openai_compatible",
  "base_url": "https://api.example.com/v1",
  "model": "example-model-name",
  "api_key_env_name": "HOLOPET_API_KEY",
  "request_timeout_ms": 30000,
  "max_output_tokens": 512,
  "max_response_bytes": 262144,
  "max_tool_rounds": 4,
  "prompt_dir": "prompts",
  "prompt_max_bytes": 65536,
  "text_only": true,
  "max_history_turns": 8,
  "content_chunk_chars": 40,
  "language": "zh",
  "_comment": "文字模式示例：Key 只从 api_key_env_name 指定的环境变量读取，配置文件中不得写入真实 Key。text_only=true 时回答完成后直接回到 Idle。"
}

# HoloPet 环境变量示例 (复制为 holopet.env 使用, 勿提交真实值)
# 注意: 本文件只包含变量名, 不包含任何真实密钥。
# 真实 holopet.env 权限建议: chmod 600

# ---- AI Worker ----
HOLOPET_WORKER_HOST=127.0.0.1
HOLOPET_WORKER_PORT=47650

# ---- OpenAI Compatible (provider=openai_compatible 时使用) ----
# API Key 只从环境变量读取; 在 holopet.env 中填写你的真实值 (勿提交)
HOLOPET_API_KEY=

# ---- 音频 (USB Audio) ----
HOLOPET_RECORD_DEVICE=
HOLOPET_PLAY_DEVICE=
HOLOPET_SAMPLE_RATE=16000
HOLOPET_RECORD_MS=6000
HOLOPET_SILENCE_DB=-35
HOLOPET_SILENCE_MS=800
